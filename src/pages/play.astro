

---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Co-Op Café" appMode={true}>
  <main class="play-page">
    <iframe
      src="https://joemolloy36.github.io/Co-OpCafeDemo"
      title="Co-Op Café"
      allow="fullscreen"
      allowfullscreen
    ></iframe>
  </main>

  <style>
    .play-page {
      width: 100%;
      height: 100vh;
      height: 100dvh;
      margin: 0;
      padding: 0;
      overflow: hidden;
    }

    iframe {
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
    }
  </style>
</Layout>


---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Play Co-Op Café">
  <main class="play-page">
    <h1>Play Co-Op Café</h1>
    <p>Step inside and start running your café.</p>

    <div class="game-container">
      <iframe
        src="https://joemolloy36.github.io/Co-OpCafeDemo"
        title="Co-Op Café WebGL Game"
        allow="fullscreen"
        allowfullscreen
      ></iframe>
    </div>
  </main>

  <style>
    .play-page {
      max-width: 1100px;
      margin: 0 auto;
      padding: 2rem 1rem;
    }

    .game-container {
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #682b0c;
      border-radius: 12px;
      overflow: hidden;
    }

    iframe {
      width: 100%;
      height: 100%;
      border: 0;
    }
  </style>
</Layout>


---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Play | ">
  <main class="play-page">
    <div class="browser-content">
      <h1>Play Co-Op Café</h1>
      
    </div>

    <iframe
      src="https://joemolloy36.github.io/Co-OpCafeDemo"
      title="Co-Op Café"
      allow="fullscreen"
      allowfullscreen
    ></iframe>
  </main>

  <script>
    const isStandalone =
      window.matchMedia("(display-mode: standalone)").matches ||
      ("standalone" in navigator &&
        (navigator as Navigator & { standalone?: boolean }).standalone === true);

    if (isStandalone) {
      document.body.classList.add("app-mode");
    }
  </script>

<style>
  .play-page {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .browser-content {
    text-align: center;
    margin-bottom: 2rem;
  }

  .play-page iframe {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border: 0;
    background: #e69927;
  }

  /* Normal mobile browser */
  @media (max-width: 768px) {
    .play-page iframe {
      height: 60vh;
      aspect-ratio: auto;
    }
  }

  /* Home Screen app mode */
  :global(body.app-mode) {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
  }

  :global(body.app-mode header),
  :global(body.app-mode footer),
  :global(body.app-mode .browser-content) {
    display: none;
  }

:global(html),
:global(body) {
  min-height: 100%;
}

:global(body.app-mode) {
  display: block;
  width: 100%;
  height: 100vh;
  height: 100dvh;
  min-height: 0;
  overflow: hidden;
}

:global(body.app-mode .play-page) {
  display: block;
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  height: 100dvh;
  max-width: none;
  margin: 0;
  padding: 0;
  overflow: hidden;
}

:global(body.app-mode .play-page iframe) {
  display: block;
  width: 100%;
  height: 100%;
  aspect-ratio: auto;
  border: 0;
}

  h1 {
    font-size: clamp(3rem, 7vw, 5rem);
    margin-top: 2px;
    margin-bottom: 2px;
    text-decoration: underline;
    text-decoration-color: #c77700;
    text-decoration-thickness: 4px;
    text-underline-offset: 12px;
  }

  p {
    font-size: 30px;
    line-height: 1.5;
    margin: 0 0 1.25rem;
  }
</style>

</Layout>

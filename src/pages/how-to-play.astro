

---
import Layout from "../layouts/Layout.astro";
---

<Layout title="How To Play | ">
  <main>
    <h1>How To Play</h1>

    <section class="about-text">
      <p>
        1. Head to the <b>Play</b> tab
      </p>

      <p>
        2. To add to home screen (IOS): Hit the <b>three dots (...)</b> in the corner of your browser
      </p>

      <p>
        3. Hit Share 
      </p>

      <p>
        4. Scroll down and Hit <i>"Add To Home Screen"</i> (Tick Open As Web App)
      </p>

      <p>
        5. To add to home screen (Android): Hit the <b>three dots (...)</b> in the corner of your browser
      </p>

      <p>
        6. Scroll down and hit "Install Application"
      </p>

      <p>
        7. Enjoy!!
      </p>



    </section>
  </main>

  <style>
    main {
      min-height: 70vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 35px;
      padding: 3rem 1.5rem;
    }

    h1 {
      font-size: clamp(3rem, 7vw, 5rem);
      margin: 0;
      text-decoration: underline;
      text-decoration-color: #c77700;
      text-decoration-thickness: 4px;
      text-underline-offset: 12px;
    }

    .about-text {
      width: 100%;
      max-width: 800px;
      padding: 2rem;
      background: #e69927;
      border: 2px solid #a36104;
      border-radius: 12px;
      text-align: left;
    }

    p {
      font-size: 30px;
      line-height: 1.5;
      margin: 0 0 1.25rem;
    }

    p:last-child {
      margin-bottom: 0;
    }

    @media (max-width: 600px) {
      main {
        gap: 30px;
        padding: 2.5rem 1rem;
      }

      .about-text {
        padding: 1.25rem;
      }

      p {
        font-size: 21px;
      }
    }
  </style>
</Layout>

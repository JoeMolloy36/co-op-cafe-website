---
import Layout from "../layouts/Layout.astro";
---

<Layout title="How To Play | ">
  <main>
    <h1>How To Play</h1>

    <div class="instructions">
      <section class="instruction-box">
        <h2>iOS (iPhone & iPad)</h2>

        <p>1. Head to the <a href="/play" class="highlight">Play</a> tab.</p>

        <p>2. Tap the <span class="highlight">Share</span> button in Safari.</p>

        <p>3. Scroll down and select <span class="highlight">Add to Home Screen</span>.</p>

        <p>4. Make sure <span class="highlight">Open as Web App</span> is ticked.</p>

        <p>5. Tap <span class="highlight">Add</span> in the corner.</p>

        <p class="finish">You're ready to play!</p>
      </section>

      <section class="instruction-box">
        <h2>Android</h2>

        <p>1. Head to the <a href="/play" class="highlight">Play</a> tab.</p>

        <p>2. Tap the <span class="highlight">three dots (...)</span> in the corner of your browser.</p>

        <p>3. Select <span class="highlight">Install app</span> or <span class="highlight">Add to Home screen</span>, depending on your browser.</p>

        <p>4. Follow the prompts to install Co-Op Café.</p>

        <p class="finish">You're ready to play!</p>
      </section>
    </div>
  </main>

  <style>
    main {
      min-height: 70vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 35px;
      padding: 3rem 1.5rem;
    }

    h1 {
      font-size: clamp(3rem, 7vw, 5rem);
      margin: 0;
      text-decoration: underline;
      text-decoration-color: #c77700;
      text-decoration-thickness: 4px;
      text-underline-offset: 12px;
    }

    .instructions {
      width: 100%;
      max-width: 900px;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 25px;
    }

    .instruction-box {
      padding: 2rem;
      background: #e69927;
      border: 2px solid #a36104;
      border-radius: 12px;
      text-align: left;
      color: #251a16;
    }

    h2 {
      font-size: 36px;
      margin: 0 0 1.5rem;
      text-align: center;
      color: #682b0c;
    }

    p {
      font-size: 25px;
      line-height: 1.5;
      margin: 0 0 1.25rem;
    }

    .highlight {
      color: #682b0c;
      font-weight: bold;
      text-decoration: underline;
      text-decoration-color: #a36104;
      text-underline-offset: 3px;
    }

    a.highlight:hover {
      color: #fff3df;
    }

    .finish {
      margin-top: 1.5rem;
      margin-bottom: 0;
      font-weight: bold;
      text-align: center;
      color: #682b0c;
    }

    @media (max-width: 650px) {
      main {
        gap: 30px;
        padding: 2.5rem 1rem;
      }

      .instructions {
        grid-template-columns: 1fr;
        gap: 20px;
      }

      .instruction-box {
        padding: 1.25rem;
      }

      h2 {
        font-size: 30px;
      }

      p {
        font-size: 21px;
      }
    }
  </style>
</Layout>

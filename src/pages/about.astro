
---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About">
  <main>
    <h1>About Co-Op Café</h1>

    <section class="about-text">
      <p>
        Co-Op Café is a cosy café simulator where you and your friends
        work together to build and run your own café.
      </p>

      <p>
        Serve customers, prepare drinks, earn money and customise your
        café to create a space that feels uniquely yours.
      </p>

      <p>
        The goal is to create a living, welcoming world where every café
        feels different and every shift brings something new.
      </p>

      <p>
        Co-Op Café is currently in development. More features and
        improvements are on the way!
      </p>
    </section>
  </main>

  <style>
    main {
      min-height: 70vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 35px;
      padding: 3rem 1.5rem;
    }

    h1 {
      font-size: clamp(3rem, 7vw, 5rem);
      margin: 0;
      text-decoration: underline;
      text-decoration-color: #c77700;
      text-decoration-thickness: 4px;
      text-underline-offset: 12px;
    }

    .about-text {
      width: 100%;
      max-width: 800px;
      padding: 2rem;
      background: #e69927;
      border: 2px solid #a36104;
      border-radius: 12px;
      text-align: left;
    }

    p {
      font-size: 30px;
      line-height: 1.5;
      margin: 0 0 1.25rem;
    }

    p:last-child {
      margin-bottom: 0;
    }

    @media (max-width: 600px) {
      main {
        gap: 30px;
        padding: 2.5rem 1rem;
      }

      .about-text {
        padding: 1.25rem;
      }

      p {
        font-size: 21px;
      }
    }
  </style>
</Layout>



---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Co-Op Café">
  <main>
    <img
      class="center-logo"
      src="/icons/icon.png"
      alt="Co-Op Café logo"
    />

    <h1>Co-Op Café</h1>
    <p>A Cozy Café Simulator.</p>
  </main>

  <style>
    main {
      min-height: 70vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      gap: 10px;
      padding: 1rem;
    }

    .center-logo {
      width: 240px;
      height: 240px;
      object-fit: contain;
      margin-bottom: 5px;
    }

    h1 {
      font-size: 80px;
      margin: 0;
    }

    p {
      font-size: 40px;
      margin: 0;
    }

    @media (max-width: 600px) {
      .center-logo {
        width: 180px;
        height: 180px;
      }

      h1 {
        font-size: clamp(2.5rem, 10vw, 5rem);
      }

      p {
        font-size: clamp(1.5rem, 5vw, 2.5rem);
      }
    }
  </style>
</Layout>

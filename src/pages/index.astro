
---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Co-Op Café">
  <main>
    <img
      class="center-logo"
      src="/icons/icon.png"
      alt="Co-Op Café logo"
    />

    <h1>Co-Op Café</h1>
    <p>A Cozy Café Simulator.</p>

    <a href="/play" class="hero-play-button">Play Demo</a>

  </main>

  <style>
    main {
      min-height: 70vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      gap: 10px;
      padding: 1rem;
    }

    .center-logo {
      width: 300px;
      height: 300px;
      object-fit: contain;
      margin-bottom: 0px;
    }

    h1 {
      font-size: 80px;
      margin: 0;
    }

    p {
      font-size: 40px;
      margin: 0;
    }

    
.hero-play-button {
  display: inline-block;
  margin-top: 32px;
  padding: 20px 50px;
  font-size: 24px;
  background: #c77700;
  color: white;
  text-decoration: none;
  font-weight: bold;
  border-radius: 8px;
  transition: background 0.2s ease;
}

.hero-play-button:hover {
  background: #965a32;
}


    @media (max-width: 600px) {
      .center-logo {
        width: 180px;
        height: 180px;
      }

      h1 {
        font-size: clamp(2.5rem, 10vw, 5rem);
      }

      p {
        font-size: clamp(1.5rem, 5vw, 2.5rem);
      }
    }

    

  </style>
</Layout>

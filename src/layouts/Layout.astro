
---
interface Props {
  title: string;
  appMode?: boolean;
}

const { title, appMode = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta name="theme-color" content="#251a16" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Co-Op Café" />

    <title>{title} | Co-Op Café</title>
    <meta
      name="description"
      content="Run your own cosy café with friends in Co-Op Café."
    />
  </head>

  <body class={appMode ? "app-mode" : ""}>
    {!appMode && (
      <header>
        <a class="logo" href="/">Co-Op Café</a>

        <nav>
          <a href="/">Home</a>
          <a href="/about">About</a>
          <a href="/how-to-play">How to Play</a>
          <a class="play-button" href="/play">Play Demo</a>
        </nav>
      </header>
    )}

    <slot />

    {!appMode && (
      <footer>
        <p>© 2026 Co-Op Café · Made by JoeDev36.</p>
      </footer>
    )}
  </body>
</html>

<style is:global>
  /* ========================================
     DESIGN SETTINGS
     Change these values to customise the site
     ======================================== */

  :root {
    /* Colours */
    --page-bg: #ffb13d;
    --header-bg: #e69927;
    --footer-bg: #e69927;

    --text-color: #f6e9d6;
    --muted-color: #f6e9d6;

    --accent-color: #a37f6f;
    --accent-hover: #f2b36f;
    --border-color: #de8807;

    /* Typography */
    --logo-size: 1.8rem;
    --nav-size: 1.3rem;
    --button-size: 1.4rem;
    --footer-size: 1.1rem;

    /* Spacing */
    --header-padding: 1.25rem 5%;
    --nav-gap: 1.25rem;
    --button-padding: 0.7rem 1.1rem;

    /* General */
    --content-width: 1200px;
    --border-radius: 8px;

    font-family: "m5x7", sans-serif;
    font-weight: bold;
    color: var(--text-color);
    background: var(--page-bg);
    font-synthesis: none;
  }

  /* ========================================
     CUSTOM FONT
     ======================================== */

  @font-face {
    font-family: "m5x7";
    src: url("/fonts/m5x7.ttf") format("truetype");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  /* ========================================
     GLOBAL STYLES
     ======================================== */

  * {
    box-sizing: border-box;
  }

  html {
    min-height: 100%;
    background: var(--page-bg);
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--page-bg);
    color: var(--text-color);
    font-family: "m5x7", sans-serif;
    font-weight: bold;
    -webkit-text-stroke: 0.5px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* Keep the main page content between header and footer */
  body > main {
    flex: 1;
  }

  /* ========================================
     HEADER
     ======================================== */

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;

    padding: var(--header-padding);

    background: var(--header-bg);
    border-bottom: 2px solid var(--border-color);
  }

  /* Website logo / title */

  .logo {
    font-size: var(--logo-size);
    font-weight: 800;
    white-space: nowrap;
  }

  /* Navigation links */

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--nav-gap);
    align-items: center;
  }

  nav a {
    font-size: var(--nav-size);
    transition: color 0.2s ease;
  }

  nav a:hover {
    color: var(--accent-hover);
  }

.text-outline {
  -webkit-text-stroke: 1px #251a16;
  paint-order: stroke fill;
}

  /* ========================================
     PLAY DEMO BUTTON
     ======================================== */

  .play-button {
    display: inline-block;

    background: var(--border-color);
    color: var(--page-bg);

    padding: var(--button-padding);
    border-radius: var(--border-radius);

    font-size: var(--button-size);
    font-weight: 700;

    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .play-button:hover {
    background: var(--accent-hover);
    color: var(--page-bg);
    transform: translateY(-2px);
  }

  .play-button:active {
    transform: translateY(0);
  }

  /* Keyboard accessibility */

  a:focus-visible {
    outline: 2px solid var(--accent-hover);
    outline-offset: 4px;
  }

  /* ========================================
     FOOTER
     ======================================== */

  footer {
    margin-top: auto;
    width: 100%;

    text-align: center;
    padding: 1.5rem 1rem;

    background: var(--footer-bg);
    color: var(--muted-color);

    border-top: 1px solid var(--border-color);
    font-size: var(--footer-size);
  }

  footer p {
    margin: 0;
  }



  /* ========================================
     APP MODE
     Used when appMode=true
     Hides the website header and footer
     ======================================== */

  body.app-mode {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    background: var(--page-bg);
  }

  body.app-mode header,
  body.app-mode footer {
    display: none;
  }

  /* ========================================
     MOBILE RESPONSIVENESS
     ======================================== */

  @media (max-width: 600px) {
    header {
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      padding: 1rem;
    }

    .logo {
      font-size: 1.6rem;
    }

    nav {
      justify-content: center;
      gap: 0.8rem;
    }

    nav a {
      font-size: 1rem;
    }

    .play-button {
      padding: 0.6rem 0.9rem;
      font-size: 1rem;
    }

    footer {
      padding: 1.2rem 0.75rem;
      font-size: 0.85rem;
    }
  }

  /* ========================================
     REDUCED MOTION ACCESSIBILITY
     ======================================== */

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>

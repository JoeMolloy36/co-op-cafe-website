
---
interface Props {
  title: string;
  appMode?: boolean;
}

const { title, appMode = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#251a16" />

    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Co-Op Café" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#682b0c" />
    <title>{title} | Co-Op Café</title>
    <meta
      name="description"
      content="Run your own cosy café with friends in Co-Op Café."
    />
  </head>
  <body class={appMode ? "app-mode" : ""}>
  {!appMode && (
    <header>
      <a class="logo" href="/">Co-Op Café</a>
      <nav>
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/how-to-play">How to Play</a>
        <a class="play-button" href="/play">Play Demo</a>
      </nav>
    </header>
  )}

  <slot />

  {!appMode && (
    <footer>
      <p>© 2026 Co-Op Café · Made by JoeDev36.</p>
    </footer>
  )}
</body>
</html>

<style is:global>
  :root {
  font-family: "m5x7", sans-serif;
   font-weight: bold;
  -webkit-text-stroke: 0.5px;
  color: #f6e9d6;
  background: #251a16;
  font-synthesis: none;
}

  


  @font-face {
  font-family: "m5x7";
  src: url("/fonts/m5x7.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}


  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 1.25rem 5%;
    border-bottom: 2px solid #a36104;
  }

  a { color: inherit; text-decoration: none; }

  .logo { font-size: 1.25rem; font-weight: 800; }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
  }

  nav a:hover { color: #f2b36f; }

  .play-button {
    background: #d98b48;
    color: #251a16;
    padding: 0.65rem 1rem;
    border-radius: 8px;
    font-weight: 700;
  }

  footer {
    text-align: center;
    padding: 2rem 1rem;
    color: #c5ad98;
    border-top: 1px solid #49352b;
  }

  body.app-mode {
  margin: 0;
  padding: 0;
  min-height: 100vh;
}

</style>
